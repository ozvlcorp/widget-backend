DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/widgets

# Обязательно. Пусто = админские ручки /admin/* отключены (503).
# Передаётся заголовком X-Admin-Secret.
ADMIN_SECRET=

# Кому разрешено обращаться к бэкенду из браузера. ["*"] удобно, но пускает
# любой сайт; на бою лучше перечислить домены виджетов.
#
# Наши собственные поддомены разрешены и без этого списка — см. ниже, так что
# для нового виджета на *.oymoysklad.com сюда ничего дописывать не нужно.
# Список нужен только для чужих доменов.
# CORS_ORIGINS=["https://partner.example.com"]

# Шаблон «своих» доменов, разрешённых дополнительно к CORS_ORIGINS.
# Сверка по fullmatch: https://наш.oymoysklad.com.чужой.com не пройдёт.
# Пустая строка отключает правило — тогда работает только CORS_ORIGINS.
# CORS_ORIGIN_REGEX=https://[a-z0-9.-]+\.oymoysklad\.com

# Сколько секунд живёт contextKey (по умолчанию 300).
# CONTEXT_KEY_TTL_SECONDS=300

# АВАРИЙНО. Разрешает выдачу токена по accountId/имени аккаунта без проверки
# contextKey. Это дыра — включать только на время, пока приложение не
# зарегистрировано в кабинете вендора.
# ALLOW_INSECURE_ACCOUNT_FALLBACK=1

# ─── Синхронизация МойСклад → Postgres ────────────────────────────────────────
# Виджет читает данные из этой базы, а не ходит в api.moysklad.ru на каждый клик.
# Наполняет её фоновый воркер по расписанию.

# Поднимать ли планировщик в этом процессе. На нескольких репликах оставьте
# 1 только у одной.
# SYNC_ENABLED=1

# Расписание в cron-формате, В UTC. По умолчанию ежедневно в 02:30 UTC.
# ВАЖНО: при ночном синке цифры за сегодня появляются только после прогона —
# до этого плитка «Сегодня» покажет ноль. Хотите видеть день по ходу дела —
# поставьте сюда что-то вроде "*/15 * * * *".
# SYNC_CRON=30 2 * * *

# Потолок времени на один прогон одного аккаунта, секунды. Первичная заливка
# всей истории в него не уложится — это нормально: курсоры сохранятся и работа
# продолжится следующей ночью.
# SYNC_MAX_SECONDS=10800

# Ширина окна при заливке истории, в днях.
# SYNC_WINDOW_DAYS=30

# Насколько глубоко в прошлое пускать заливку. 0 = до самого раннего документа
# аккаунта. Поставьте, например, 400, чтобы ограничить историю ~годом.
# SYNC_BACKFILL_MAX_DAYS=0

# Через сколько минут без heartbeat прогон считается мёртвым и аккаунт
# разблокируется. Спасает от вечной блокировки после падения контейнера.
# SYNC_STALE_RUN_MINUTES=90
